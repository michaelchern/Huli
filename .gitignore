# 构建目录 / Build trees
/[Bb]uild/
/[Bb]uild-*/
/[Oo]ut/
/cmake-build-*/

# 本地工具缓存 / Local tool caches
/.cache/
__pycache__/
*.py[cod]

# CMake 用户本地配置和生成状态 / CMake user-local and generated state
/CMakeUserPresets.json
/CMakeLists.txt.user
/CMakeCache.txt
/CMakeFiles/
/CTestTestfile.cmake
/Testing/
/_deps/
/.cmake/api/v1/
/cmake_install.cmake
/install_manifest.txt
/compile_commands.json
/build.ninja
/.ninja_deps
/.ninja_log

# Visual Studio 本地状态 / Visual Studio local state
/.vs/
/CppProperties.json
*.suo
*.user
*.userosscache
*.sln.docstates
*.aps
*.cachefile
*.ipch
*.ncb
*.opendb
*.opensdf
*.sdf
*.VC.db
*.VC.VC.opendb
ipch/

# 临时文件和备份文件 / Temporary and backup files
*~
*.bak
*.bkp
*.dtmp
*.swp
*.swo
*.tmp
~$*

# 操作系统元数据 / Operating-system metadata
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Desktop.ini
ehthumbs.db
Thumbs.db

# Huli 本地规划状态；复制后的项目不使用此功能时，请移除此节。 / Huli-local planning state; remove this section when a copied project does not use it.
/.planning/

# 仅当项目实际使用时，才添加包管理器、覆盖率、生成资源或其他 IDE 规则。 / Add package-manager, coverage, generated-asset, or other IDE rules only when a project uses them.
